// ============================================================================
// Loki output
// ============================================================================

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


// ============================================================================
// Docker container logs
// ============================================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  // Docker container name: /grafana -> grafana
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  // Useful Docker metadata
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"

  targets = discovery.relabel.docker_logs.output

  labels = {
    platform = "docker",
  }

  forward_to = [loki.write.local.receiver]
}


// ============================================================================
// Host / Linux logs
// ============================================================================

local.file_match "linux_logs" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/host_logs/{syslog,messages,*.log}",

    platform = "host",
  }]
}

loki.source.file "linux_logs" {
  targets    = local.file_match.linux_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "journald" {
  forward_to = [loki.write.local.receiver]

  labels = {
    platform = "host",
    source   = "journald",
  }
}

// ============================================================================
// Prometheus
// ============================================================================


prometheus.scrape "cadvisor" {
  targets = [
    {
      "__address__" = "cadvisor:8080",
    },
  ]

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.local.receiver,
  ]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// node_exporter

prometheus.scrape "node_exporter" {
  targets = [
    {
      "__address__" = "node-exporter:9100",
    },
  ]

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.local.receiver,
  ]
}